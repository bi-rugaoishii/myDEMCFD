      {
          "axis": "y",
          "side": "min",
          "boundary_id": 1
      },

      {
          "axis": "y",
          "side": "max",
          "boundary_id": 1
      },
      {
          "axis": "z",
          "side": "min",
          "boundary_id": 1
      },
      {
          "axis": "z",
