CC = nvcc
CC_C = gcc
ARCH = sm_70 
CFLAGS = -O3 -Xcompiler "-Wconversion  -Werror  -fopenmp"  
GPUFLAGS = -DUSE_GPU=1 -arch=$(ARCH) -fmad=false 
#CFLAGS = -O0 -g -G
#CFLAGS = -O3  -pg
#CFLAGS = -O0  -g 
#CFLAGS = -Xcompiler "-fsanitize=address -fno-omit-frame-pointer" -O0  -g  
CONLYFLAGS = -O3  
DEMPATH = DEM
LIBS = -lm 
OBJS =  ${DEMPATH}/main.o  ${DEMPATH}/ParticleSystem.o ${DEMPATH}/cJSON_d.o ${DEMPATH}/TriangleMesh.o ${DEMPATH}/settings_loader.o ${DEMPATH}/solver_output.o ${DEMPATH}/BVH.o ${DEMPATH}/BoundingBox.o ${DEMPATH}/cpu_dem.o ${DEMPATH}/device_dem.o

PROGRAM = myDEM3d

all: $(PROGRAM)

$(PROGRAM): $(OBJS)
	$(CC) $(CFLAGS) $(GPUFLAGS) $(OBJS) $(LIBS)  -o $(PROGRAM)

%.o : %.cu
	$(CC) $(CFLAGS) $(GPUFLAGS) -c $< -o $@

%.o : %.c
	$(CC_C) $(CONLYFLAGS) -c $< -o $@ 

clean:
	rm -f $(PROGRAM)  $(OBJS)

