CC = nvcc
CC_C = g++

ARCH = sm_70

CFLAGS = -O3 -Xcompiler "-Wconversion -Werror -fopenmp"
GPUFLAGS = -DUSE_GPU=1 -arch=$(ARCH) -fmad=false
CONLYFLAGS = -O3
INCLUDE = -I${CFDPATH}/third_party

# Automatic header dependencies
DEPFLAGS = -MMD -MP

CFDPATH = CFD
DEMPATH = DEM
DEMCFDPATH = Coupling

LIBS = -lm

OBJS = ${DEMCFDPATH}/main.o \
       ${DEMCFDPATH}/G_DEMCFDCoupling.o \
       ${CFDPATH}/SMACSolver.o \
       ${CFDPATH}/CFDTime.o \
       ${CFDPATH}/G_SMACSolver.o \
       ${CFDPATH}/FileInOut.o \
       ${CFDPATH}/SimulationSetup.o \
       ${CFDPATH}/G_SMACSolver_VoF.o \
       ${CFDPATH}/G_SMACSolver_IBM.o \
       ${CFDPATH}/G_BoundaryFunctions.o \
       ${CFDPATH}/pressure_solver/G_PressureSolverBase.o \
       ${CFDPATH}/pressure_solver/G_PCGSolver.o \
       ${CFDPATH}/pressure_solver/G_GMGSolver.o \
       ${CFDPATH}/pressure_solver/G_Levels.o \
       ${CFDPATH}/config/ConfigLoader.o \
       ${CFDPATH}/config/SimulationConfig.o \
       ${DEMPATH}/ParticleSystem.o \
       ${DEMPATH}/cJSON_d.o \
       ${DEMPATH}/TriangleMesh.o \
       ${DEMPATH}/settings_loader.o \
       ${DEMPATH}/solver_output.o \
       ${DEMPATH}/BVH.o \
       ${DEMPATH}/BoundingBox.o \
       ${DEMPATH}/cpu_dem.o \
       ${DEMPATH}/device_dem.o

DEPS = $(OBJS:.o=.d)

PROGRAM = myDEMCFD

all: $(PROGRAM)

$(PROGRAM): $(OBJS)
	$(CC) $(CFLAGS) $(GPUFLAGS) $(OBJS) $(LIBS) -o $(PROGRAM)

%.o: %.cu
	$(CC) $(CFLAGS) $(GPUFLAGS) $(INCLUDE) $(DEPFLAGS) \
		-MF $(@:.o=.d) -MT $@ \
		-c $< -o $@

%.o: %.cpp
	$(CC_C) $(CONLYFLAGS) $(INCLUDE) $(DEPFLAGS) \
		-MF $(@:.o=.d) -MT $@ \
		-c $< -o $@

clean:
	rm -f $(PROGRAM) $(OBJS) $(DEPS)

-include $(DEPS)
